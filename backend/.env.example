# Copy to .env on the SERVER; fill through the host's secret manager.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=manasati
JWT_SECRET=
PUBLIC_APP_URL=https://your-platform.example
CORS_ORIGINS=https://your-platform.example
# Optional initial administrator: no default administrator is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Existing platform subscription checkout (test only)
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_API_BASE=https://api.tap.company/v2
TAP_LIVE_ALLOWED=false
TAP_WEBHOOK_URL=https://your-platform.example/api/payments/tap/webhook
TAP_REDIRECT_URL=https://your-platform.example/payment/result
# Commerce/segment credentials are distinct from the platform's own subscription merchant.
TAP_COMMERCE_ENABLED=false
TAP_COMMERCE_SECRET_KEY=
TAP_PLATFORM_ID=
# Payout API permission must be provided by Tap; webhook remains disabled pending signature contract.
TAP_PAYOUTS_ENABLED=false
TAP_PAYOUT_SECRET_KEY=
# No real domain purchases until registration, currency and provider setup are verified.
RESELLERCLUB_ENV=test
RESELLERCLUB_API_KEY=
RESELLERCLUB_RESELLER_ID=
RESELLERCLUB_BASE_URL=https://test.httpapi.com/api
RESELLERCLUB_AVAILABILITY_URL=https://test.httpapi.com/api
RESELLERCLUB_PRICE_CURRENCY=
CUSTOM_DOMAIN_TARGET_IP=
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_REPLY_TO=
